encoding  utf-8

survey crni-potok -title "Izvir Črnega potoka (Šratlova jama)"

	# input the map definitions
	input ./crni-potok-p.thm #plan view
	input ./crni-potok-e.thm #extended elevation view

    # input the individual survey data files
    # input ./2026/entrance/entrance.th
    input ./2026/sump01/sump01.th
    input ./2026/dry01/dry01.th

    # equate stations between different surveys
    equate -1@sump01 0@dry01
    # equate 12@sump02 1@dry01

    # connect the individual scraps - plan view
    # join sump01-1p@sump01 sump02-1p@sump02
    # join sump02-1p@sump02 dry01-1p@dry01

    # connect the individual scraps - extended view
    # join sump01-1e@sump01 sump02-1e@sump02
    # join sump02-1e@sump02 dry01-1e@dry01

    centerline
        cs epsg:3912
        station 69@sump01 "Vhod / Entrance - FIX DODAJ SUHI DEL" entrance
        fix 69@sump01 475238 50322 510
    endcenterline
    
endsurvey